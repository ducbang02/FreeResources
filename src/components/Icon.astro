---
interface Props { name?: string; }
const {name='arrow'}=Astro.props;
const paths:Record<string,string>={arrow:'M5 12h14m-5-5 5 5-5 5',chevron:'m9 5 7 7-7 7',plus:'M12 5v14M5 12h14',menu:'M4 6h16M4 12h16M4 18h16',close:'m5 5 14 14M19 5 5 19',external:'M14 3h7v7m0-7L10 14M10 4H4v16h16v-6',filter:'M4 5h16M7 12h10M10 19h4',list:'M9 6h11M9 12h11M9 18h11M4 6h.1M4 12h.1M4 18h.1'};
---
<svg class="ui-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name==='search'?<><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></>:name==='grid'?<><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></>:<path d={paths[name]||paths.arrow}/>}
</svg>
