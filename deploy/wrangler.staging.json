{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "digital-resource-hub-staging",
  "account_id": "4ca521c6746d874c049fd829121ab59e",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digital-resource-hub-staging",
      "database_id": "e28f4099-92cf-40bc-ab8c-c47138b4469d",
      "migrations_dir": "../migrations",
      "remote": false
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "APP_ENV": "staging"
  },
  "previews": {
    "vars": {
      "APP_ENV": "staging"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "digital-resource-hub-staging",
        "database_id": "e28f4099-92cf-40bc-ab8c-c47138b4469d",
        "migrations_dir": "../migrations",
        "remote": false
      }
    ]
  }
}
